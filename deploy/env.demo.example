# Copy to .env next to the demo compose. Never commit the real .env.

# Cloudflare Tunnel token for dyr.rad710.com (Dashboard → Tunnels → your tunnel).
CF_TUNNEL_TOKEN=

# Must match DYR_DB_PASSWORD in the platform (shared MySQL) .env.
DYR_DB_PASSWORD=change-me-dyr

# JWT signing key for this app (any strong string; openssl rand -hex 24).
JWT_SECRET=change-me-jwt

# Which pushed image tag to run (latest, or pin to a released version).
IMAGE_TAG=latest

# Demo credentials shown on the login screen / used by the seed.
DEMO_EMAIL=demo@rad710.com
DEMO_PASSWORD=DemoPass123
