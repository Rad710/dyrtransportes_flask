# Copy to .env next to docker-compose.prod.yml. Never commit the real .env.
# Generate strong values, e.g.  openssl rand -hex 24

# Signs the JWTs. Anyone who knows it can forge a token for any user
API_KEY=change-me-jwt-secret

# MySQL root password. On a volume that already exists, changing this value
# does NOT change the password, run inside the mysql container:
#   ALTER USER 'root'@'%' IDENTIFIED BY 'the-new-password'; FLUSH PRIVILEGES;
MYSQL_ROOT_PASSWORD=change-me-root

# Credentials the API connects with, must match the MySQL user above
DB_USERNAME=root
DB_PASSWORD=change-me-root
